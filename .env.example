# === Service Ports ===
BACKEND_PORT=8000
REDIS_PORT=6379
QDRANT_PORT=6333

# === Redis ===
REDIS_HOST=redis

# === Qdrant ===
QDRANT_HOST=qdrant

# === Gemini API ===
GEMINI_API_KEY=your-gemini-api-key-here

# === Embedding API (bước 4 mới cần) ===
OPENAI_API_KEY=your-openai-api-key-here

# === Auth ===
# Secret ký JWT — có default cho dev, PHẢI đổi nếu triển khai thật
JWT_SECRET=dev-only-insecure-secret-change-me
