# === Service Ports ===
BACKEND_PORT=8000
REDIS_PORT=6379
QDRANT_PORT=6333

# === Redis ===
REDIS_HOST=redis

# === Qdrant ===
QDRANT_HOST=qdrant

# === Gemini API ===
GEMINI_API_KEY=your-gemini-api-key-here
# Model dùng cho bước phân loại (nhanh) và bước sinh câu trả lời RAG (chất lượng).
# Có thể để chung 1 model, hoặc tách riêng nếu muốn dùng model mạnh hơn cho câu trả lời.
# Free tier giới hạn request/ngày theo từng (project, model) — nếu gặp lỗi 429/503 liên tục,
# thử đổi sang alias ổn định "gemini-flash-latest" thay vì ghim cứng 1 phiên bản.
GEMINI_MODEL_FAST=gemini-flash-latest
GEMINI_MODEL_QUALITY=gemini-flash-latest

# === Embedding API (bước 4 mới cần) ===
OPENAI_API_KEY=your-openai-api-key-here

# === Auth ===
# Secret ký JWT — có default cho dev, PHẢI đổi nếu triển khai thật
JWT_SECRET=dev-only-insecure-secret-change-me
